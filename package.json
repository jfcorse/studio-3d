{
  "name": "studio-3d",
  "productName": "Studio 3D",
  "version": "1.0.0",
  "description": "Studio 3,73 × 4,04 m en 3D : aménagement, mobilier, couleurs et plans.",
  "author": "jfcorse",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node build/make-icon.js",
    "dist": "electron-builder --win --publish never",
    "dist:zip": "electron-builder --win zip --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jfcorse.studio3d",
    "productName": "Studio 3D",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "studio-3d.html",
      "vendor/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Studio 3D",
      "artifactName": "Studio-3D-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Studio-3D-portable-${version}.${ext}"
    }
  }
}
